# API mode supported by BoneMetGPT. Copy this file to source/.env and use that file locally.
# Create your own OpenAI key at https://platform.openai.com/api-keys.
# For another OpenAI-compatible service, obtain a key and API URL from your provider.
OPENAI_API_KEY=
# Optional API base. Example format: https://your-provider.example/v1
OPENAI_API_BASE=

# Optional API backend and model. Select the model in the chat UI or enter one below.
# Examples: api and gpt-4o-mini.
LLM_PROVIDER=
API_LLM_MODEL=
LLM_API_MODEL=

# Alternative key/base names for existing setups. Leave unused aliases blank.
# API_LLM_* takes precedence over LLM_* and then OPENAI_*.
API_LLM_API_KEY=
LLM_API_KEY=
API_LLM_BASE_URL=
LLM_API_BASE_URL=

# Optional SDK defaults. Examples: 0.0, 60 (seconds), 2.
# Ordinary chat turns use their own 30-second budget and make no automatic retries.
LLM_TEMPERATURE=
LLM_TIMEOUT=
LLM_MAX_RETRIES=

# The package launcher binds the configuration and accepts -PythonExe at startup.
# Standalone development can use the path format <absolute path to the file>.
LATTICEGPT_CONFIG=
LATTICEGPT_PYTHON=

